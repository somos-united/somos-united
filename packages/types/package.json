{
  "name": "@somos/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript types: hand-authored Supabase Database type (mirrors supabase/migrations) + placeholder Sanity content types.",
  "main": "./src/index.ts",
