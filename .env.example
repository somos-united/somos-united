# Somos United — environment variables (01-ARCHITECTURE.md §5)
#
# Placeholder values only — never real secrets. Real secrets live only in
# Vercel Environment Variables, split per project/environment
# (Preview/Staging/Production), never in this repo.
#
# Naming: NEXT_PUBLIC_* is exclusively for values allowed to be visible in
# the browser (e.g. Sanity project ID, Supabase anon key). Everything else
# has no prefix and is server-only.

# -----------------------------------------------------------------------------
# Sanity (CMS — redaktioneller Content)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID="your-sanity-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-01-01"
SANITY_API_TOKEN="skXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
SANITY_STUDIO_PROJECT_ID="your-sanity-project-id"
SANITY_STUDIO_DATASET="production"
# Notion → Sanity content-sync (01-ARCHITECTURE.md §8)
NOTION_INTEGRATION_TOKEN="secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NOTION_CONTENT_DATABASE_ID="00000000000000000000000000000000"
NOTION_WEBHOOK_SIGNING_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# Supabase (DB, Auth, Storage, Edge Functions — Region Zürich eu-central-2)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_SERVICE_ROLE_KEY="eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_DB_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_JWT_SECRET="your-jwt-secret"

# -----------------------------------------------------------------------------
# Stripe (Zahlungen/Abos)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# Resend (transaktionale E-Mails + später Resend Inbound für
# email_messages, siehe 07-MODULE-CRM.md §4). Domain mail.somosunited.ch
# live verifiziert seit 2026-08-27 (Sending enabled, Receiving noch aus —
# das ist die spätere Resend-Inbound-Ausbaustufe). RESEND_FROM_ADDRESS
# korrigiert 2026-09-04: muss auf der bei Resend verifizierten Domain
# liegen (mail.somosunited.ch), nicht auf der nackten Root-Domain, die
# dort nicht verifiziert ist.
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_INBOUND_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_ADDRESS="hello@mail.somosunited.ch"
RESEND_INBOUND_DOMAIN="mail.somosunited.ch"

# -----------------------------------------------------------------------------
# Bird, ehem. MessageBird (SMS + WhatsApp — Buchungs-Reminder, CRM-Alerts,
# siehe 07-MODULE-CRM.md §3). Ersetzt Twilio (2026-09-03, dauerhaft
# ausgeschlossen). BIRD_API_KEY live verifiziert 2026-09-04 (in Vercel
# Production eingetragen). BIRD_WHATSAPP_FROM gegen das echte
# @messagebird/sdk@0.52.0-Typing verifiziert 2026-09-04: `from` bei
# bird.whatsapp.send ist die Absender-Telefonnummer im E.164-Format, keine
# Channel-UUID (war vorher als BIRD_WHATSAPP_CHANNEL_ID falsch benannt/
# -geshaped, vor Prüfung gegen die reale SDK geraten).
# -----------------------------------------------------------------------------
BIRD_API_KEY="bk_xxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BIRD_API_REGION="eu1"
BIRD_SMS_SENDER_ID="SOMOSUnited"
BIRD_WHATSAPP_FROM="+41xxxxxxxxx"

# -----------------------------------------------------------------------------
# Cloudflare (DNS, WAF, Access — Zero-Trust-Gate vor Admin-/Trainer-App)
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLOUDFLARE_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLOUDFLARE_ZONE_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLOUDFLARE_ACCESS_AUD_TAG="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# Google (Search Console + Analytics — KPIs im Admin-Dashboard,
# siehe 07-MODULE-CRM.md §6 / dashboard_metrics_cache)
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL="somos-united-analytics@your-gcp-project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"
GOOGLE_ANALYTICS_PROPERTY_ID="000000000"
GOOGLE_SEARCH_CONSOLE_SITE_URL="https://somosunited.ch"
NEXT_PUBLIC_GOOGLE_ANALYTICS_MEASUREMENT_ID="G-XXXXXXXXXX"

# -----------------------------------------------------------------------------
# Snyk / Socket (Dependency-Security-Scans — nur CI, siehe .github/workflows/ci.yml)
# -----------------------------------------------------------------------------
SNYK_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SNYK_ORG="somos-united"
SOCKET_SECURITY_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# Preview gate (Phase 1 in-progress public site, served at /preview behind
# HTTP Basic Auth — apps/web/middleware.ts. Public holding page at / stays
# ungated. Not a real security boundary, just keeps work-in-progress off
# the public URL until Phase 1 ships.)
# -----------------------------------------------------------------------------
PREVIEW_AUTH_USER="Admin"
PREVIEW_AUTH_PASSWORD="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# App-level (non-secret runtime config that must still not be hardcoded in
# source — 00-MASTER-PLAN.md §0)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="de"
