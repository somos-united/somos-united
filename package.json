{
  "name": "somos-united",
  "version": "0.0.0",
  "private": true,
  "description": "Somos United — monorepo (Phase 0 foundation)",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:bird-sms": "tsx scripts/test-bird-sms.ts"
  },
  "devDependencies": {
    "turbo": "2.1.3",
    "tsx": "4.23.13",
    "typescript": "5.5.4"
  }
}
